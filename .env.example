# ---------------------------
# Valorant (Henrik API)
# ---------------------------
VAL_PUUID=your_valorant_puuid_here
HENRIK_API_KEY=your_henrik_api_key_here
VAL_REGION=eu
VAL_PLATFORM=pc

# ---------------------------
# League of Legends (Riot API)
# ---------------------------
LOL_PUUID=your_lol_puuid_here
LOL_REGION=europe
LOL_PLATFORM=euw1
RIOT_API_KEY=your_riot_api_key_here

# ---------------------------
# Twitch (Helix)
# ---------------------------
TWITCH_CHANNEL=your_twitch_channel_login_here
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_ACCESS_TOKEN=your_twitch_access_token_here

# ---------------------------
# Cloudflare Worker
# ---------------------------
# Fallback URL used for both !rank and !streak if dedicated URLs are not set:
CF_WORKER_UPDATE_URL=https://your-worker-domain.workers.dev/update

# Optional dedicated endpoints (recommended if rank/session are separate workers):
CF_RANK_UPDATE_URL=
CF_SESSION_UPDATE_URL=

CF_UPDATE_TOKEN=your_cloudflare_update_token_here

# ---------------------------
# Runtime
# ---------------------------
POLL_INTERVAL_SECONDS=20
TEST_MODE=false
